{
  "seed": 2026,
  "device": "cuda:0",
  "history": 48,
  "horizon": 24,
  "stride": 24,
  "data": {
    "kind": "real",
    "flow": "data/flow.csv",
    "adjacency": "data/adjacency.csv",
    "train_end": "2022-11-15",
    "val_end": "2022-12-01",
    "scaling": "zero_one",
    "train_stride": 1,
    "static_blocks": {
      "poi": {
        "path": "data/static.csv",
        "columns": [
          "poi_count"
        ],
        "availability": "fixed"
      },
      "bus": {
        "path": "data/static.csv",
        "columns": [
          "bus_count"
        ],
        "availability": "fixed"
      }
    },
    "fixed_periodic_blocks": {
      "timetable": {
        "path": "data/timetable_period.csv",
        "columns": [
          "service_frequency"
        ],
        "anchor_minutes": 120
      }
    },
    "daily_observation_blocks": {
      "weather": {
        "path": "data/weather_daily.csv",
        "columns": [
          "temp",
          "humidity",
          "windspeed",
          "precip"
        ],
        "delay_hours": 24
      }
    },
    "observed_station_list": "data/observed_stations.json"
  },
  "model": {
    "name": "dbts",
    "width": 192,
    "heads": 4,
    "enc_layers": 4,
    "dec_layers": 3,
    "gcn": true,
    "tdb": true,
    "rb": true,
    "placement": "both",
    "self_loops": false,
    "dcl": true,
    "mask_ratio": 0.2,
    "temperature": 0.2,
    "decoder_fusion": "paper_add"
  },
  "diffusion": {
    "steps": 1000,
    "lambda_time": 1.0,
    "lambda_fft": 1.5,
    "lambda_dcl": 0.1,
    "weight_mode": "paper",
    "lambda_s": 1.0,
    "objective": "paper_l2",
    "scenario_loss_weight": 0.1,
    "scenario_width": 32
  },
  "training": {
    "steps": 7500,
    "batch_size": 32,
    "checkpoint_every": 250,
    "exclude_overlapping_dcl": true,
    "gradient_accumulation": 2,
    "optimizer": {
      "lr": 1e-05,
      "ema_decay": 0.995,
      "ema_mode": "ema_pytorch",
      "ema_update_every": 10,
      "scheduler": {
        "factor": 0.5,
        "patience": 5000,
        "min_lr": 1e-05,
        "threshold": 0.1,
        "threshold_mode": "rel",
        "warmup_lr": 0.0008,
        "warmup": 500,
        "verbose": false
      }
    }
  },
  "evaluation": {
    "sample_seeds": [
      1001, 1002, 1003, 1004, 1005,
      1006, 1007, 1008, 1009, 1010,
      1011, 1012, 1013, 1014, 1015,
      1016, 1017, 1018, 1019, 1020
    ],
    "max_origins": null,
    "batch_size": 16,
    "splits": [
      "val",
      "test"
    ],
    "sampler": {
      "method": "ddim",
      "sampling_steps": 200,
      "schedule": "endpoints",
      "clip_x0": true,
      "guidance_mode": "scenario",
      "reference_strength": 0.1,
      "score_strength": 0.05
    }
  }
}
