{
  "seed": 2026,
  "device": "cuda:0",
  "history": 48,
  "horizon": 24,
  "stride": 24,
  "data": {
    "kind": "real",
    "flow": "data/flow.csv",
    "adjacency": "data/adjacency.csv",
    "train_end": "2022-11-15",
    "val_end": "2022-12-01",
    "trailing_partial": "error",
    "dynamic_blocks": {
      "weather": {
        "path": "data/weather_vintages.csv",
        "enabled": true,
        "columns": [
          "temperature",
          "humidity",
          "wind_speed",
          "precipitation"
        ]
      },
      "timetable": {
        "path": "data/timetable_vintages.csv",
        "enabled": true,
        "columns": [
          "service_frequency"
        ]
      }
    },
    "static_blocks": {
      "poi": {
        "path": "data/poi_snapshot.csv",
        "enabled": true,
        "columns": [
          "poi"
        ]
      },
      "bus": {
        "path": "data/bus_snapshot.csv",
        "enabled": true,
        "columns": [
          "bus"
        ]
      }
    }
  },
  "model": {
    "name": "dbts",
    "width": 192,
    "heads": 4,
    "enc_layers": 4,
    "dec_layers": 3,
    "gcn": false,
    "tdb": true,
    "rb": true,
    "placement": "both",
    "self_loops": false,
    "dcl": true,
    "mask_ratio": 0.2,
    "temperature": 0.2,
    "decoder_fusion": "paper_add"
  },
  "diffusion": {
    "steps": 1000,
    "lambda_time": 1.0,
    "lambda_fft": 1.5,
    "lambda_dcl": 0.1,
    "weight_mode": "paper",
    "lambda_s": 1.0,
    "objective": "paper_l2",
    "scenario_loss_weight": 0.1,
    "scenario_width": 32
  },
  "training": {
    "steps": 7500,
    "batch_size": 32,
    "checkpoint_every": 250,
    "exclude_overlapping_dcl": true,
    "optimizer": {
      "lr": 0.0001,
      "ema_decay": 0.995,
      "ema_mode": "constant"
    }
  },
  "evaluation": {
    "sample_seeds": [
      1001, 1002, 1003, 1004, 1005,
      1006, 1007, 1008, 1009, 1010,
      1011, 1012, 1013, 1014, 1015,
      1016, 1017, 1018, 1019, 1020
    ],
    "max_origins": null,
    "batch_size": 16,
    "splits": [
      "val",
      "test"
    ],
    "sampler": {
      "method": "ddim",
      "sampling_steps": 200,
      "schedule": "endpoints",
      "clip_x0": true,
      "guidance_mode": "scenario",
      "reference_strength": 0.1,
      "score_strength": 0.05
    }
  }
}
